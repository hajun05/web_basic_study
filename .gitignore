# ---------------------------------------------------------------
# 보안: 비밀 정보는 절대 커밋하지 않는다
# ---------------------------------------------------------------

# 환경변수 파일 (API 키, DB 비밀번호 등). 값 없는 예시 파일만 허용
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 인증서 / 개인키 / 키스토어
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.gpg
*.asc
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk

# 자격 증명 / 시크릿 파일
secrets/
.secrets/
secret.*
secrets.*
credentials*
*credentials.json
service-account*.json
serviceAccount*.json
client_secret*.json
.npmrc
.yarnrc.yml
.netrc
.htpasswd
.aws/
.ssh/
.docker/config.json

# 로컬 DB / 덤프 / 백업 (개인정보 포함 가능)
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.bak

# Claude Code 로컬 설정 (허용한 명령/경로 등 개인 환경 정보 포함)
.claude/settings.local.json
.claude/*.local.*

# ---------------------------------------------------------------
# 의존성
# ---------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------
# 빌드 결과물 / 캐시
# ---------------------------------------------------------------
/.next/
/out/
/build
/dist
/coverage
.turbo/
.vercel
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# 로그
# ---------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------
# 에디터 / OS
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
